<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121214"
    android:padding="24dp">

    <!-- 1. Integrated Hero Status Panel (Clean Header, No Cards!) -->
    <LinearLayout
        android:id="@+id/layoutHeroHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_shield"
            app:tint="#A29BFE"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parental Console"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Organic Pulsing Security Node Status -->
    <LinearLayout
        android:id="@+id/layoutGlobalNodeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeroHeader"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/viewGlobalStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/btn_round"
            android:backgroundTint="#34C759"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvGlobalStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Secure"
            android:textColor="#34C759"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Consolidated Horizontal Health Status Badges -->
    <LinearLayout
        android:id="@+id/layoutHealthBadges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/layoutGlobalNodeStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Badge 1: Accessibility Status -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/badgeAccessibility"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="#1D1D21"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <View
                    android:id="@+id/viewAccessDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/btn_round"
                    android:backgroundTint="#FF453A"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Service Node"
                        android:textColor="#8E8E93"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAccessStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disabled (Tap)"
                        android:textColor="#FF453A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Badge 2: Uninstall Protection -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/badgeDeviceAdmin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="#1D1D21"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <View
                    android:id="@+id/viewAdminDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/btn_round"
                    android:backgroundTint="#FF453A"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Uninstall Lock"
                        android:textColor="#8E8E93"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAdminStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unprotected"
                        android:textColor="#FF453A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <View
        android:id="@+id/dividerTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#0DFFFFFF"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHealthBadges"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. Borderless Premium Settings List Deck -->
    <TextView
        android:id="@+id/tvModulesHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Console Settings"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/dividerTop"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvModulesHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: App Guard Blocker & Scheduler Limits -->
        <LinearLayout
            android:id="@+id/rowAppLimits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <!-- Rounded Indigo Icon Circle -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_round"
                android:backgroundTint="#13A29BFE"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_shield"
                    app:tint="#A29BFE"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App &amp; Time Restrictions"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAppGuardStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 apps restricted | 0 active schedules"
                    android:textColor="#8E8E93"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_back"
                android:rotation="180"
                app:tint="#44FFFFFF" />
        </LinearLayout>

        <!-- Divider Row -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#0DFFFFFF" />

        <!-- Row 2: Change Lock Pin -->
        <LinearLayout
            android:id="@+id/rowAccessPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <!-- Rounded Key Icon Circle -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_round"
                android:backgroundTint="#13D0BCFF"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_key"
                    app:tint="#D0BCFF"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Access Control Passcode"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modify your Master Security PIN"
                    android:textColor="#8E8E93"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_back"
                android:rotation="180"
                app:tint="#44FFFFFF" />
        </LinearLayout>
        
        <!-- Divider Bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#0DFFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
